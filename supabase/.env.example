# War2aty — Edge Function secrets TEMPLATE (F06-T01)
#
# Copy to `supabase/.env` and fill in real values. `supabase/.env` is
# git-ignored and MUST stay that way. Never put these values in Flutter code,
# `config.toml`, dart-defines, or any committed file (§24).
#
# Local:  supabase functions serve --env-file supabase/.env
# Remote: supabase secrets set --env-file supabase/.env

# ── AI analysis providers ────────────────────────────────────────────────────
# Analysis runs Mistral first and falls back to Groq (F20-T11). BOTH are
# required: a deployment missing either key or model fails every analysis as
# INTERNAL_ERROR before a slot is taken, rather than quietly running on one.
# All run on FREE tiers; see the data-handling note at the bottom of this
# block before adding a key.

# Mistral — the primary. Obtain a key from https://console.mistral.ai/api-keys
# (the free "Experiment" plan needs no card).
MISTRAL_API_KEY=
# Chosen by the F20-T09 benchmark. On the free plan only the Ministral family
# is usable: mistral-small-*, mistral-medium-* and magistral-* have a limit of
# 0 requests/minute there, so every call would 429 and fall back to Groq.
MISTRAL_MODEL=ministral-14b-latest

# Groq — the fallback. Obtain from https://console.groq.com/keys
GROQ_API_KEY=
# MUST be a model that supports `response_format: json_schema`. Verified on
# 2026-07-26: only openai/gpt-oss-120b and openai/gpt-oss-20b do. Everything
# else on the account — including llama-3.3-70b-versatile, qwen3.6-27b and
# allam-2-7b — answers 400 "This model does not support response format
# json_schema", which would leave the analysis unconstrained (F06-T11).
GROQ_MODEL=openai/gpt-oss-120b

# Gemini — the online OCR provider (F20-T07), read by `ocr-document` once T13
# wires it. Obtain a key from https://aistudio.google.com/apikey. No billing
# account and no card required for the free tier.
#
# ⚠ SET BOTH IN THE SAME `secrets set` CALL. Both are required and neither is
# defaulted: a missing one fails every online reading as INTERNAL_ERROR, which
# the app deliberately does NOT fall back to Tesseract from (matrix row O6).
GEMINI_API_KEY=
# Chosen by the F20-T09 benchmark. On the free tier the 3.x Flash models
# answered 503 about half the time; Flash-Lite was reliable. Avoid
# gemini-1.5-flash (retired, 404).
GEMINI_MODEL=gemini-3.5-flash-lite
#
# DATA HANDLING (F18-T02, F20 context §3, CLAUDE.md §7):
#   • Gemini receives the IMAGE of the paper, and returns its text. Nothing
#     else is sent to it, and the image is not kept on our side.
#   • Gemini's FREE tier terms allow Google to use submitted content to improve
#     its products, and state that human reviewers may read API input and
#     output. The owner accepted this for images; F20-T24 rewrites the privacy
#     copy to say so. No user-facing string may claim nobody sees the image
#     once it is sent here, nor name the provider.
#   • Mistral receives the OCR TEXT. Its free plan may use it to train
#     models unless training is switched off in the Mistral console (decision
#     D2): switch it off before adding the key.
#   • Groq commits to no training on inputs or outputs on either tier.

# Salt used to hash installation_id before it is stored (never store it raw).
# Generate with: openssl rand -hex 32
INSTALLATION_HASH_SALT=

# Runtime defaults. The `app_runtime_config` table (F06-T08) overrides these at
# runtime; these are the fallbacks when a key is missing.
DAILY_ANALYSIS_LIMIT=3
MAX_OCR_CHARACTERS=12000
ANALYSIS_SCHEMA_VERSION=1.0
# Must stay BELOW the client's analysisTimeout (30s in RuntimeConfig.defaults),
# so the server times out first, releases the reserved slot and answers 408
# TIMEOUT — instead of the client giving up on an analysis that still counts.
AI_TIMEOUT_SECONDS=25

# The analysis chain's timing inside that budget (F20 timeout contract §2).
# Optional: unset means the values below, set in F20-T09 from the benchmark's
# p95s. A value that is set but not a positive number fails every analysis as
# INTERNAL_ERROR before a slot is taken.
# The longest one provider attempt may run. Mistral's slowest call was 14.7 s;
# 18 s leaves 7 s of the 25 s budget for Groq when Mistral hangs.
AI_ATTEMPT_TIMEOUT_SECONDS=18
# The least time left worth starting Groq with (its p95 was 3.1 s). Below
# this, the request answers the primary's failure instead of a second call.
MIN_FALLBACK_MS=5000

# Azure AI Document Intelligence (F13-T03) — dark until the `azure_ocr_enabled`
# row in `app_runtime_config` is explicitly set true (defaults false; see
# RuntimeConfig.azureOcrEnabled). Both vars hard-fail at startup if missing
# once something actually reads them (T04) — never silently skipped.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Google Document AI (F13-T03) — the conditional second-opinion provider
# (T08). Values come from a downloaded service-account JSON key; PROJECT_ID/
# LOCATION/PROCESSOR_ID identify the specific Document AI processor to call.
# All five hard-fail at startup if missing once something actually reads them
# (T07). PRIVATE_KEY keeps its "\n" escapes exactly as the JSON file has them —
# googleDocumentAiOptionsFromEnv() unescapes them, do not paste real newlines.
GOOGLE_DOCUMENT_AI_CLIENT_EMAIL=
GOOGLE_DOCUMENT_AI_PRIVATE_KEY=
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
