<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows a system splash before the app draws, and it
         cannot be turned off. Without these it falls back to the launcher
         icon on a theme-coloured background.

         F28-T05: it shows the brand teal AND the mark, so the mark is on
         screen from ~100 ms instead of ~775 ms (F27-T18, D-2), and
         `MainActivity` removes the splash without its default exit animation
         so the mark does not move between this layer and Flutter's first
         frame.

         F33: `splash_icon` is a bitmap centred on a 288 dp canvas, not a
         drawable that pins the mark to 128 dp — because the size a drawable
         declares here is never the size it gets. The platform hands the icon
         a viewport of 1.5 x (160 dp x 1.2) = 288 dp, stretches the drawable
         across it whatever its own size says, and clips the result to the
         inner 192 dp with the device's icon mask. T05 pinned `128dp` inside
         a `layer-list`; that 128 dp canvas was scaled to 288 dp like any
         other, so the mark reached the screen at ~227 dp — half the width of
         the phone — with its sides cut flat by the mask. Only the ratio
         inside the drawable survives the trip, so the mark is 128 of the
         canvas's 288 dp and the generator cuts every density that way. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
