<?xml version="1.0" encoding="utf-8"?>
<!-- F27-P01: adaptive launcher icon (Android 8+). The layers are generated by
     tool/branding/generate_brand_assets.dart; the dev flavor overrides only
     the background (src/dev/res). The monochrome layer is the Android 13+
     themed icon; older versions ignore it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
