<?xml version="1.0" encoding="utf-8"?>
<!--
  F06-T14 · Cleartext HTTP, for the local Supabase stack only.

  Android 9 (API 28) blocks cleartext traffic by default, and the dev flavor
  talks to `http://10.0.2.2:54321` — the emulator's alias for the developer's
  machine. Without this every request fails before it leaves the device.

  Deliberately NOT `android:usesCleartextTraffic="true"` on <application>:
  that would permit plain HTTP to ANY host in a release build, which would let
  an attacker on the same network read OCR text in transit. Only loopback and
  the emulator host are listed here, and neither is reachable in production —
  so a release build remains HTTPS-only with no separate manifest to maintain.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The emulator's alias for the host machine's loopback. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- A device on the same LAN, when SUPABASE_URL points at the host. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
